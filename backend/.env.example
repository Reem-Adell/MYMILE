# ==============================================================================
# MYMILE – ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Application Security
SECRET_KEY=mymile-hackathon-super-secret-key-change-in-production-2026
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 1. AI Model Configuration (Optional: Gemini or OpenAI)
# ------------------------------------------------------------------------------
# Supported providers: gemini | openai
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-1.5-flash

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (Obtain from https://platform.openai.com/)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Sponsor 1: Channel3 E-Commerce API (https://www.channel3.ai/)
# ------------------------------------------------------------------------------
# Obtain from Channel3 Developer Dashboard
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.channel3.ai/v1

# ------------------------------------------------------------------------------
# 3. Sponsor 2: APIMatic API Integration (https://www.apimatic.io/)
# ------------------------------------------------------------------------------
# Obtain from APIMatic Developer Portal
APIMATIC_API_KEY=
APIMATIC_BASE_URL=https://api.apimatic.io/v1

# ------------------------------------------------------------------------------
# 4. External Services: Weather, Hotels, Places
# ------------------------------------------------------------------------------
# Default weather provider: Open-Meteo (100% free, real live weather, no key required)
WEATHER_API_KEY=
WEATHER_BASE_URL=https://api.open-meteo.com/v1

# Optional commercial hotel/places keys (if integrating TripAdvisor/Booking/Geoapify)
HOTEL_API_KEY=
HOTEL_BASE_URL=
PLACES_API_KEY=
PLACES_BASE_URL=
