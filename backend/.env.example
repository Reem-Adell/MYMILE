# ==============================================================================
# MYMILE – ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Application Security
# REQUIRED. Signs login tokens. The backend refuses to start if this is empty,
# shorter than 32 characters, or a known placeholder. Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the real value. Changing it logs everyone out.
SECRET_KEY=
ENVIRONMENT=development
# MYMILE's own log level (Groq token usage is logged at INFO). Uvicorn logs are unaffected.
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 1. AI Model Configuration (Groq primary, Gemini optional)
# ------------------------------------------------------------------------------
# The AI travel agent (trip planning + chat) uses Groq's OpenAI-compatible API
# through the `openai` package. Without the provider's API key the app still
# works, but itineraries are clearly labelled templates and the chat assistant
# says it is unavailable. Providers never fall back to each other automatically.
LLM_PROVIDER=groq
# Groq API key (https://console.groq.com/keys). Server-side only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Per Groq request (always capped by AI_AGENT_DEADLINE_SECONDS for the whole run).
GROQ_TIMEOUT_SECONDS=60
# low | medium | high. "low" keeps tool rounds fast and token use small.
GROQ_REASONING_EFFORT=low
# Output caps per request, reasoning tokens included: short tool-call rounds; the final
# JSON gets GROQ_FINAL_BASE_TOKENS, never above GROQ_MAX_COMPLETION_TOKENS
# (also the limit of the single retry after a truncated answer).
GROQ_TOOL_ROUND_MAX_TOKENS=1024
GROQ_FINAL_BASE_TOKENS=3000
GROQ_MAX_COMPLETION_TOKENS=8192
# HTTP 429: retry at most this many times per request, waiting Groq's retry-after,
# and only when that wait is <= GROQ_RETRY_MAX_WAIT_SECONDS and fits the deadline.
GROQ_RATE_LIMIT_RETRIES=2
GROQ_RETRY_MAX_WAIT_SECONDS=20
AI_AGENT_DEADLINE_SECONDS=180
# Identical trip requests reuse the cached AI plan for this many hours.
AI_PLAN_CACHE_TTL_HOURS=24

# --- Optional: Google Gemini (used only when LLM_PROVIDER=gemini) ---
# Leave empty for the default (gemini-3.8-flash). Retired Gemini 1.x names are replaced.
LLM_MODEL_NAME=gemini-3.8-flash
# Per Gemini request (also sent to Google as its server-side deadline).
GEMINI_TIMEOUT_SECONDS=90
# low | medium | high. "low" keeps tool rounds fast; empty = the model's default.
GEMINI_THINKING_LEVEL=low
# Google Gemini API Key (Obtain from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Not used by the current code (no OpenAI provider is implemented).
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Sponsor 1: Channel3 product search (docs: https://channel3.ai/docs)
# ------------------------------------------------------------------------------
# API key from your Channel3 dashboard; sent as the x-api-key header to
# POST https://api.trychannel3.com/v1/search. Each search costs 1 credit
# (1,000 free per month), so results are cached and each trip runs at most
# CHANNEL3_MAX_QUERIES_PER_TRIP unique searches (hard maximum 6, initial and
# follow-up searches combined). Without a key no products are shown.
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
CHANNEL3_CACHE_TTL_HOURS=24
CHANNEL3_TIMEOUT_SECONDS=15
CHANNEL3_MAX_QUERIES_PER_TRIP=6
# Products per search (max 10). 5 gives enough candidates for ~10 recommended products.
CHANNEL3_RESULTS_PER_QUERY=5

# ------------------------------------------------------------------------------
# 3b. Sponsor: PayPal Payments – SANDBOX ONLY (https://developer.paypal.com/)
# ------------------------------------------------------------------------------
# Create a Sandbox REST app at https://developer.paypal.com/dashboard/applications/sandbox
# and copy its Client ID and Secret here. Never commit real values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Only "sandbox" is accepted right now. Any other value does not stop the app
# from starting; it is rejected when the PayPal client is first created
# (i.e. on the first PayPal request), which then fails with a clear error.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_TIMEOUT_SECONDS=30

# Premium pass: ONE-TIME payment for a fixed period of Premium access.
# NOT a recurring subscription – it does not auto-renew.
PREMIUM_PRICE=9.00
PREMIUM_CURRENCY=USD
PREMIUM_DURATION_DAYS=30

# ------------------------------------------------------------------------------
# 4. External Services: Weather, Hotels, Places
# ------------------------------------------------------------------------------
# Default weather provider: Open-Meteo (100% free, real live weather, no key required)
WEATHER_API_KEY=
WEATHER_BASE_URL=https://api.open-meteo.com/v1

# Hotels: SerpApi Google Hotels (https://serpapi.com/manage-api-key).
# With a key, Explore shows real hotels, listed prices and provider booking links.
# Every new search costs one SerpApi search (free plan: 250/month), so results are
# cached in the database for HOTEL_CACHE_TTL_HOURS. Without a key, MYMILE's curated
# hotels with estimated prices are shown.
HOTEL_API_KEY=
HOTEL_CACHE_TTL_HOURS=24
HOTEL_API_TIMEOUT_SECONDS=15
HOTEL_BASE_URL=
PLACES_API_KEY=
PLACES_BASE_URL=

# Explore hero destination photos (Wikipedia / Wikimedia Commons, no API key).
# Wikimedia requires contact details in the User-Agent of API clients: put an
# email address or website you are happy to share with Wikimedia. Leave empty to
# disable photo lookups (the Explore hero then shows a branded fallback).
WIKIMEDIA_CONTACT=
